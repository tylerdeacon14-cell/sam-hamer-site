      <div class="form-block fade-up">
        <div class="form-block-header">
          <div class="block-num">1</div>
          <div>
            <div class="block-title">The basics</div>
            <div class="block-subtitle">Your name, location, and what you create</div>
          </div>
        </div>
        <div class="form-block-body">
          <div class="row-2">
            <div class="field"><label>Your Name</label><input type="text" name="name" placeholder="First and last" required></div>
            <div class="field"><label>Email</label><input type="email" name="email" placeholder="you@email.com" required></div>
          </div>
          <div class="field"><label>City and State</label><input type="text" name="location" placeholder="e.g. Chicago, IL"></div>
          <div class="field"><label>What you post about</label>
            <div class="pill-group" id="niche-pills">
              <button type="button" class="pill" onclick="togglePillMulti(this,'niche-pills','niche')">Beauty &amp; Skincare</button>
              <button type="button" class="pill" onclick="togglePillMulti(this,'niche-pills','niche')">Health &amp; Wellness</button>
              <button type="button" class="pill" onclick="togglePillMulti(this,'niche-pills','niche')">Fitness</button>
              <button type="button" class="pill" onclick="togglePillMulti(this,'niche-pills','niche')">Fashion</button>
              <button type="button" class="pill" onclick="togglePillMulti(this,'niche-pills','niche')">Home &amp; Kitchen</button>
              <button type="button" class="pill" onclick="togglePillMulti(this,'niche-pills','niche')">Food &amp; Beverage</button>
              <button type="button" class="pill" onclick="togglePillMulti(this,'niche-pills','niche')">Tech &amp; AI</button>
              <button type="button" class="pill" onclick="togglePillMulti(this,'niche-pills','niche')">Finance &amp; Business</button>
              <button type="button" class="pill" onclick="togglePillMulti(this,'niche-pills','niche')">Pets</button>
              <button type="button" class="pill" onclick="togglePillMulti(this,'niche-pills','niche')">Lifestyle</button>
              <button type="button" class="pill" onclick="togglePillMulti(this,'niche-pills','niche')">Travel</button>
              <button type="button" class="pill" onclick="togglePillMulti(this,'niche-pills','niche')">Comedy &amp; Entertainment</button>
            </div>
            <input type="hidden" name="niche" id="niche">
            <input type="text" name="niche_other" placeholder="Or type it in: AI tools, luxury, gaming..." style="margin-top:10px;">
          </div>
          <div class="field">
            <label>Your tagline <span style="color:#2a2a2a;font-size:10px;text-transform:none;letter-spacing:0;font-weight:500;">optional ,  we can write this for you</span></label>
            <input type="text" name="tagline" placeholder='e.g. "Content that stops the scroll and closes the deal."'>
            <div class="field-note">A short hook that lives under your name on the site. Leave blank and we will write one.</div>
          </div>
        </div>
      </div>

      <!-- BLOCK 2: YOUR ACCOUNTS -->
      <div class="form-block fade-up">
        <div class="form-block-header">
          <div class="block-num">2</div>
          <div>
            <div class="block-title">Your accounts</div>
            <div class="block-subtitle">Up to 4 accounts ,  handle, followers, likes, active or former</div>
          </div>
        </div>
        <div class="form-block-body">
          <div class="col-headers">
            <span class="ch-platform">Platform</span>
            <span class="ch-handle">Handle</span>
            <span class="ch-followers">Followers</span>
            <span class="ch-likes">Total Likes</span>
            <span class="ch-freq">Post Frequency</span>
            <span class="ch-spacer"></span>
          </div>
          <div id="accounts-container">
            <div class="account-row">
              <div class="account-row-inner">
                <div class="field-platform"><div class="field">
                  <select name="platform_1">
                    <option value="TikTok" selected style="background:#111;">TikTok</option>
                    <option value="TikTok Shop" style="background:#111;">TikTok Shop</option>
                    <option value="Instagram" style="background:#111;">Instagram</option>
                    <option value="YouTube" style="background:#111;">YouTube</option>
                    <option value="X / Twitter" style="background:#111;">X / Twitter</option>
                    <option value="Facebook" style="background:#111;">Facebook</option>
                    <option value="Pinterest" style="background:#111;">Pinterest</option>
                    <option value="LinkedIn" style="background:#111;">LinkedIn</option>
                    <option value="Other" style="background:#111;">Other</option>
                  </select>
                </div></div>
                <div class="field-handle"><div class="field"><input type="text" name="handle_1" placeholder="@yourhandle"></div></div>
                <div class="field-followers"><div class="field"><input type="text" name="followers_1" placeholder="e.g. 13K"></div></div>
                <div class="field-likes"><div class="field"><input type="text" name="likes_1" placeholder="e.g. 684K"></div></div>
                <div class="field-freq"><div class="field"><input type="text" name="post_freq_1" placeholder="e.g. Daily, 3x per week"></div></div>
                <button type="button" class="remove-btn" onclick="removeRow(this)" title="Remove">x</button>
              </div>
            </div>
            <div class="account-row">
              <div class="account-row-inner">
                <div class="field-platform"><div class="field">
                  <select name="platform_2">
                    <option value="TikTok" style="background:#111;">TikTok</option>
                    <option value="TikTok Shop" style="background:#111;">TikTok Shop</option>
                    <option value="Instagram" selected style="background:#111;">Instagram</option>
                    <option value="YouTube" style="background:#111;">YouTube</option>
                    <option value="X / Twitter" style="background:#111;">X / Twitter</option>
                    <option value="Facebook" style="background:#111;">Facebook</option>
                    <option value="Pinterest" style="background:#111;">Pinterest</option>
                    <option value="LinkedIn" style="background:#111;">LinkedIn</option>
                    <option value="Other" style="background:#111;">Other</option>
                  </select>
                </div></div>
                <div class="field-handle"><div class="field"><input type="text" name="handle_2" placeholder="@yourhandle"></div></div>
                <div class="field-followers"><div class="field"><input type="text" name="followers_2" placeholder="e.g. 4.2K"></div></div>
                <div class="field-likes"><div class="field"><input type="text" name="likes_2" placeholder="e.g. 120K"></div></div>
                <div class="field-freq"><div class="field"><input type="text" name="post_freq_2" placeholder="e.g. Daily, 3x per week"></div></div>
                <button type="button" class="remove-btn" onclick="removeRow(this)" title="Remove">x</button>
              </div>
            </div>
          </div>
          <button type="button" class="add-row-btn" id="add-account-btn">+ Add another account</button>
        </div>
      </div>

      <!-- BLOCK 3: YOUR BEST VIDEOS -->
      <div class="form-block fade-up">
        <div class="form-block-header">
          <div class="block-num">3</div>
          <div>
            <div class="block-title">Your best videos</div>
            <div class="block-subtitle">Paste 4-5 TikTok URLs ,  open tiktok.com in desktop, copy the address bar URL</div>
            <div style="font-size:12px;color:#555;margin-top:4px;line-height:1.5;">On mobile: tap Share on your TikTok video, then tap Copy Link. Paste that here.</div>
          </div>
        </div>
        <div class="form-block-body">
          <div class="video-input-list">
            <div class="video-input-row"><span class="video-num">1</span><div class="field" style="margin:0;flex:1;"><input type="url" name="video_1" placeholder="https://www.tiktok.com/@yourhandle/video/..."></div></div>
            <div class="video-input-row"><span class="video-num">2</span><div class="field" style="margin:0;flex:1;"><input type="url" name="video_2" placeholder="https://www.tiktok.com/@yourhandle/video/..."></div></div>
            <div class="video-input-row"><span class="video-num">3</span><div class="field" style="margin:0;flex:1;"><input type="url" name="video_3" placeholder="https://www.tiktok.com/@yourhandle/video/..."></div></div>
            <div class="video-input-row"><span class="video-num">4</span><div class="field" style="margin:0;flex:1;"><input type="url" name="video_4" placeholder="https://www.tiktok.com/@yourhandle/video/..."></div></div>
            <div class="video-input-row"><span class="video-num">5</span><div class="field" style="margin:0;flex:1;"><input type="url" name="video_5" placeholder="https://www.tiktok.com/@yourhandle/video/..."></div></div>
          </div>
          <div class="field-note" style="margin-top:14px;">These will be embedded on your site. Pick ones that look consistent ,  similar aspect ratio, similar style.</div>
        </div>
      </div>

      <!-- BLOCK 4: YOUR JOURNEY -->
      <div class="form-block fade-up">
        <div class="form-block-header">
          <div class="block-num">4</div>
          <div>
            <div class="block-title">Your journey</div>
            <div class="block-subtitle">5 milestones, rough dates are fine ,  we will write the story</div>
          </div>
        </div>
        <div class="form-block-body">
          <div class="milestone-list">
            <div class="milestone-row"><span class="milestone-num">1</span><div class="field" style="margin:0;flex:1;"><input type="text" name="milestone_1" placeholder='e.g. "Early 2023 - started first account from scratch"'></div></div>
            <div class="milestone-row"><span class="milestone-num">2</span><div class="field" style="margin:0;flex:1;"><input type="text" name="milestone_2" placeholder='e.g. "Month 6 - first brand reached out"'></div></div>
            <div class="milestone-row"><span class="milestone-num">3</span><div class="field" style="margin:0;flex:1;"><input type="text" name="milestone_3" placeholder='e.g. "2024 - hit 10K, one video went to 500K views"'></div></div>
            <div class="milestone-row"><span class="milestone-num">4</span><div class="field" style="margin:0;flex:1;"><input type="text" name="milestone_4" placeholder='e.g. "Signed first paid deal"'></div></div>
            <div class="milestone-row"><span class="milestone-num">5</span><div class="field" style="margin:0;flex:1;"><input type="text" name="milestone_5" placeholder='e.g. "Now - 3 active brand partnerships, posting daily"'></div></div>
          </div>
          <div class="field-note" style="margin-top:14px;">Short is fine. Just tell us what happened and when. We will turn it into the timeline section on your site.</div>
        </div>
      </div>

      <!-- BLOCK 5: YOUR LOOK -->
      <div class="form-block fade-up">
        <div class="form-block-header">
          <div class="block-num">5</div>
          <div>
            <div class="block-title">Your look and feel</div>
            <div class="block-subtitle">Colors, vibe, and any other links</div>
          </div>
        </div>
        <div class="form-block-body">
          <div class="field">
            <label>Favorite color(s) <span style="color:#2a2a2a;font-size:10px;text-transform:none;letter-spacing:0;font-weight:500;">used as accent throughout the site</span></label>
            <input type="text" name="colors" placeholder="e.g. Electric blue, hot pink, lime green ,  or just dark and minimal">
          </div>
          <div class="field">
            <label>Vibe</label>
            <div class="vibe-grid">
              <div class="vibe-option"><input type="radio" name="vibe" id="v1" value="Dark and moody"><label for="v1">Dark and moody</label></div>
              <div class="vibe-option"><input type="radio" name="vibe" id="v2" value="Clean and minimal"><label for="v2">Clean and minimal</label></div>
              <div class="vibe-option"><input type="radio" name="vibe" id="v3" value="Bold and loud"><label for="v3">Bold and loud</label></div>
              <div class="vibe-option"><input type="radio" name="vibe" id="v4" value="Soft and warm"><label for="v4">Soft and warm</label></div>
              <div class="vibe-option"><input type="radio" name="vibe" id="v5" value="Streetwear / hype"><label for="v5">Streetwear / hype</label></div>
              <div class="vibe-option"><input type="radio" name="vibe" id="v6" value="Professional / corporate"><label for="v6">Professional / corporate</label></div>
            </div>
          </div>
          <div class="field"><label>Any sites, creators, or brands whose look you love? <span style="color:#2a2a2a;font-size:10px;text-transform:none;letter-spacing:0;font-weight:500;">optional</span></label><input type="text" name="inspiration" placeholder="e.g. a TikTok handle, a website you like, a brand aesthetic you want us to reference."></div>
          <div class="field"><label>Other links to include <span style="color:#2a2a2a;font-size:10px;text-transform:none;letter-spacing:0;font-weight:500;">optional</span></label><input type="text" name="other_links" placeholder="e.g. Instagram, YouTube, Linktree, personal site"></div>
        </div>
      </div>

      <!-- BLOCK 6: YOUR PHOTOS -->
      <div class="form-block fade-up">
        <div class="form-block-header">
          <div class="block-num">6</div>
          <div>
            <div class="block-title">Your photos</div>
            <div class="block-subtitle">Hero photo plus TikTok profile screenshots</div>
          </div>
        </div>
        <div class="form-block-body">
          <div class="field">
            <label>Hero photo</label>
            <div class="upload-zone" id="hero-zone">
              <input type="file" name="hero_photo" accept="image/*" onchange="markUploaded(this,'hero-zone','hero-label')">
              <div class="upload-icon">+</div>
              <div class="upload-label" id="hero-label">Click to upload or drag and drop</div>
              <div class="upload-sub">Portrait preferred. Clear face, decent lighting. JPG or PNG.</div>
            </div>
          </div>
          <div class="field" style="margin-top:16px;">
            <label>TikTok profile screenshots <span style="color:var(--accent);font-size:10px;text-transform:none;letter-spacing:0;font-weight:700;">one per account, at tiktok.com/@yourhandle</span></label>
            <div class="upload-zone" id="ss-zone">
              <input type="file" name="profile_screenshots" accept="image/*" multiple onchange="markUploaded(this,'ss-zone','ss-label')">
              <div class="upload-icon">+</div>
              <div class="upload-label" id="ss-label">Click to upload or drag and drop</div>
              <div class="upload-sub">Can select multiple files at once.</div>
            </div>
          </div>
          <div class="field-note" style="margin-top:12px;">If uploads do not work on your device, just email the photos to <a href="mailto:dreambillboard@gmail.com" style="color:#444;">dreambillboard@gmail.com</a> with your name in the subject line.</div>
        </div>
      </div>

      <!-- BLOCK 7: CONTENT STATS -->
      <div class="form-block fade-up">
        <div class="form-block-header">
          <div class="block-num">7</div>
          <div>
            <div class="block-title">Your credibility. In numbers.</div>
            <div class="block-subtitle">Brands scan these first. Views, GMV, deals completed. These become your social proof.</div>
          </div>
        </div>
        <div class="form-block-body">
          <div class="field">
            <label>Avg. video views</label>
            <input type="text" name="avg_views" placeholder="e.g. 5K, 50K, 200K">
          </div>
          <div class="field" style="margin-top:20px;">
            <label>Total GMV (TikTok Shop sales generated) <span style="color:#2a2a2a;font-size:10px;text-transform:none;letter-spacing:0;font-weight:500;">optional</span></label>
            <input type="text" name="total_gmv" placeholder="e.g. $12K, $227K, just starting out" style="width:100%;background:#0d0d0d;color:#f0f0f0;border:1px solid rgba(255,255,255,0.07);border-radius:10px;padding:13px 16px;font-size:14px;font-family:Inter,sans-serif;outline:none;transition:border-color 0.15s;" onfocus="this.style.borderColor='rgba(200,255,0,0.35)'" onblur="this.style.borderColor='rgba(255,255,255,0.07)'">
          </div>
          <div class="field" style="margin-top:20px;">
            <label>Brand deals completed <span style="color:#2a2a2a;font-size:10px;text-transform:none;letter-spacing:0;font-weight:500;">optional</span></label>
            <input type="text" name="brand_deals" placeholder="e.g. 3 paid deals, 12 gifted, none yet" style="width:100%;background:#0d0d0d;color:#f0f0f0;border:1px solid rgba(255,255,255,0.07);border-radius:10px;padding:13px 16px;font-size:14px;font-family:Inter,sans-serif;outline:none;transition:border-color 0.15s;" onfocus="this.style.borderColor='rgba(200,255,0,0.35)'" onblur="this.style.borderColor='rgba(255,255,255,0.07)'">
          </div>
          <div class="field" style="margin-top:20px;">
            <label>Best single video views</label>
            <input type="text" name="best_views" placeholder="e.g. 780K, 1.2M, around 50K" style="width:100%;background:#0d0d0d;color:#f0f0f0;border:1px solid rgba(255,255,255,0.07);border-radius:10px;padding:13px 16px;font-size:14px;font-family:Inter,sans-serif;outline:none;transition:border-color 0.15s;" onfocus="this.style.borderColor='rgba(200,255,0,0.35)'" onblur="this.style.borderColor='rgba(255,255,255,0.07)'">
          </div>
          <div class="field" style="margin-top:24px;">
            <label>Primary audience age</label>
            <div class="pill-group" id="age-pills">
              <button type="button" class="pill" onclick="selectPill(this,'age-pills','audience_age')">13 - 17</button>
              <button type="button" class="pill" onclick="selectPill(this,'age-pills','audience_age')">18 - 24</button>
              <button type="button" class="pill" onclick="selectPill(this,'age-pills','audience_age')">25 - 34</button>
              <button type="button" class="pill" onclick="selectPill(this,'age-pills','audience_age')">35 - 44</button>
              <button type="button" class="pill" onclick="selectPill(this,'age-pills','audience_age')">45+</button>
              <button type="button" class="pill" onclick="selectPill(this,'age-pills','audience_age')">Mixed</button>
            </div>
            <input type="hidden" name="audience_age" id="audience_age">
          </div>
          <div class="field" style="margin-top:24px;">
            <label>Audience gender split &nbsp;<span style="color:var(--accent);font-weight:800;font-size:12px;" id="gender-label">50% F / 50% M</span></label>
            <input type="range" id="gender-slider" min="0" max="100" value="50" class="range-slider" oninput="updateGender(this)">
            <input type="hidden" name="gender_split" id="gender_split" value="50% Female / 50% Male">
            <div class="slider-ticks"><span>All female</span><span>50/50</span><span>All male</span></div>
          </div>
          <div class="field"><label>Product categories you work in</label>
            <div class="check-grid">
              <label class="check-item"><input type="checkbox" name="categories[]" value="Beauty and Skincare"><span>Beauty and skincare</span></label>
              <label class="check-item"><input type="checkbox" name="categories[]" value="Health and Wellness"><span>Health and wellness</span></label>
              <label class="check-item"><input type="checkbox" name="categories[]" value="Fashion and Apparel"><span>Fashion and apparel</span></label>
              <label class="check-item"><input type="checkbox" name="categories[]" value="Home and Kitchen"><span>Home and kitchen</span></label>
              <label class="check-item"><input type="checkbox" name="categories[]" value="Food and Beverage"><span>Food and beverage</span></label>
              <label class="check-item"><input type="checkbox" name="categories[]" value="Fitness and Sports"><span>Fitness and sports</span></label>
              <label class="check-item"><input type="checkbox" name="categories[]" value="Personal Care"><span>Personal care</span></label>
              <label class="check-item"><input type="checkbox" name="categories[]" value="Pet Supplies"><span>Pet supplies</span></label>
              <label class="check-item"><input type="checkbox" name="categories[]" value="Baby and Kids"><span>Baby and kids</span></label>
              <label class="check-item"><input type="checkbox" name="categories[]" value="Tech and Gadgets"><span>Tech and gadgets</span></label>
              <label class="check-item"><input type="checkbox" name="categories[]" value="Jewelry and Accessories"><span>Jewelry and accessories</span></label>
              <label class="check-item"><input type="checkbox" name="categories[]" value="Cleaning and Household"><span>Cleaning and household</span></label>
              <label class="check-item"><input type="checkbox" name="categories[]" value="Supplements and Vitamins"><span>Supplements and vitamins</span></label>
              <label class="check-item"><input type="checkbox" name="categories[]" value="Outdoor and Garden"><span>Outdoor and garden</span></label>
              <label class="check-item"><input type="checkbox" name="categories[]" value="Other"><span>Other</span></label>
            </div>
          </div>
          <div class="field" style="margin-top:16px;"><label>Content style ,  how would you describe your videos?</label><textarea name="content_style" placeholder="e.g. Fast-paced, honest reviews. Hook-first. Real reactions, no scripts." rows="3"></textarea></div>
          <div class="field"><label>Brands you have worked with <span style="color:#2a2a2a;font-size:10px;text-transform:none;letter-spacing:0;font-weight:500;">optional</span></label><input type="text" name="past_brands" placeholder="e.g. Hismile, Bloom Nutrition, RYZE ,  or none yet"></div>
        </div>
      </div>

      <!-- SUBMISSION SECTION -->
      <div style="background:linear-gradient(135deg,rgba(200,255,0,0.05),rgba(200,255,0,0.02));border:2px solid rgba(200,255,0,0.25);border-radius:18px;padding:32px 36px;margin-bottom:28px;position:relative;overflow:hidden;box-shadow:0 0 40px rgba(200,255,0,0.08);" class="fade-up">
        <div style="position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(200,255,0,0.5),transparent);"></div>
        <div style="font-size:10px;font-weight:800;letter-spacing:2.5px;text-transf