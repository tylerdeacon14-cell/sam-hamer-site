<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>What You Get · Tyler Dream Site Builds</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; scrollbar-width: none; }
    html::-webkit-scrollbar { display: none; }
    ::selection { background: rgba(200,255,0,0.25); color: #fff; }
    :root {
      --bg: #080808; --surface: #101010;
      --border: rgba(255,255,255,0.07);
      --accent: #c8ff00; --mint: #A0EDD8;
      --text: #f0f0f0; --muted: #666;
    }
    body { background: var(--bg); color: var(--text); font-family: 'Inter', sans-serif; -webkit-font-smoothing: antialiased; overflow-x: hidden; }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }
    @keyframes shimmer { 0%{background-position:200% center} 100%{background-position:-200% center} }
    @keyframes float { 0%,100%{transform:translateY(0px)} 50%{transform:translateY(-6px)} }
    @keyframes fadeUp { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }

    .top-banner {
      position: fixed; top: 0; left: 0; right: 0; z-index: 110;
      background: linear-gradient(90deg, rgba(160,237,216,0.08) 0%, rgba(200,255,0,0.05) 100%);
      border-bottom: 1px solid rgba(160,237,216,0.2);
      padding: 12px 32px; display: flex; align-items: center; justify-content: center; gap: 16px;
      font-size: 13px; color: #a0edd8; font-weight: 600;
    }
    .top-banner a {
      background: #a0edd8; color: #080808; padding: 8px 16px; border-radius: 8px;
      text-decoration: none; font-weight: 700; font-size: 12px; transition: opacity 0.15s;
    }
    .top-banner a:hover { opacity: 0.85; }

    nav {
      position: fixed; top: 48px; left: 0; right: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 16px 32px; background: rgba(8,8,8,0.95);
      backdrop-filter: blur(24px); border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    .nav-logo { font-size: 15px; font-weight: 800; color: var(--text); text-decoration: none; letter-spacing: -0.5px; }
    .nav-logo em { color: var(--accent); font-style: normal; }
    .nav-back { font-size: 13px; font-weight: 600; color: var(--muted); text-decoration: none; transition: color 0.15s; }
    .nav-back:hover { color: var(--text); }

    .wrap { max-width: 900px; margin: 0 auto; padding: 0 32px; }

    /* HERO */
    .hero {
      padding: 120px 0 64px;
      text-align: center;
      position: relative; overflow: hidden;
    }
    .hero::before {
      content: ''; position: absolute; top: 0; left: 50%; transform: translateX(-50%);
      width: 700px; height: 500px;
      background: radial-gradient(ellipse, rgba(200,255,0,0.06) 0%, transparent 70%);
      pointer-events: none;
    }
    .badge {
      display: inline-flex; align-items: center; gap: 8px;
      background: rgba(200,255,0,0.07); border: 1px solid rgba(200,255,0,0.2);
      border-radius: 100px; padding: 6px 16px; margin-bottom: 28px;
      font-size: 11px; font-weight: 700; color: var(--accent);
      text-transform: uppercase; letter-spacing: 1.5px;
    }
    .badge span { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); animation: pulse 2s infinite; flex-shrink: 0; }
    .hero h1 {
      font-size: clamp(38px,5.5vw,68px); font-weight: 900;
      letter-spacing: -3px; line-height: 1.0; margin-bottom: 20px;
      background: linear-gradient(135deg, #fff 55%, rgba(200,255,0,0.7) 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    }
    .hero p { font-size: 15px; color: var(--muted); line-height: 1.65; max-width: 520px; margin: 0 auto 48px; }

    /* PRICE PILL */
    .price-pill {
      display: inline-flex; align-items: center; gap: 20px; flex-wrap: wrap; justify-content: center;
      background: rgba(200,255,0,0.05); border: 1px solid rgba(200,255,0,0.2);
      border-radius: 20px; padding: 20px 32px; margin-bottom: 64px;
    }
    .price-num { font-size: 52px; font-weight: 900; letter-spacing: -3px; color: var(--accent); line-height: 1; }
    .price-meta { text-align: left; }
    .price-meta strong { display: block; font-size: 15px; font-weight: 800; color: #fff; }
    .price-meta span { font-size: 13px; color: var(--muted); }

    /* DELIVERABLES GRID */
    .deliverables {
      display: grid; grid-template-columns: repeat(3,1fr); gap: 16px;
      margin-bottom: 64px;
    }
    .del-card {
      background: linear-gradient(160deg,#121212,#0d0d0d);
      border: 1px solid rgba(255,255,255,0.07); border-radius: 20px;
      padding: 28px 24px;
      transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    }
    .del-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 48px rgba(0,0,0,0.5), 0 0 0 1px rgba(200,255,0,0.1);
      border-color: rgba(200,255,0,0.15);
    }
    .del-icon {
      width: 40px; height: 40px; border-radius: 12px;
      background: rgba(200,255,0,0.08); border: 1px solid rgba(200,255,0,0.15);
      display: flex; align-items: center; justify-content: center;
      font-size: 18px; margin-bottom: 16px;
    }
    .del-title { font-size: 14px; font-weight: 800; color: #fff; margin-bottom: 6px; }
    .del-desc { font-size: 12px; color: var(--muted); line-height: 1.6; }

    /* MOCKUP SHOWCASE */
    .showcase-label {
      font-size: 11px; font-weight: 800; letter-spacing: 2.5px;
      text-transform: uppercase; color: var(--accent);
      display: flex; align-items: center; gap: 10px; margin-bottom: 32px;
    }
    .showcase-label::before {
      content: ''; display: block; width: 6px; height: 6px;
      border-radius: 50%; background: var(--accent); animation: pulse 2s infinite;
    }

    /* BROWSER MOCKUP */
    .browser-wrap {
      border-radius: 20px; overflow: hidden;
      border: 1px solid rgba(255,255,255,0.1);
      box-shadow: 0 48px 96px rgba(0,0,0,0.7), 0 0 0 1px rgba(200,255,0,0.06);
      margin-bottom: 16px; animation: float 6s ease-in-out infinite;
    }
    .browser-bar {
      background: #141414; padding: 12px 16px;
      display: flex; align-items: center; gap: 10px;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .browser-dots { display: flex; gap: 6px; }
    .browser-dots span { width: 10px; height: 10px; border-radius: 50%; }
    .browser-url {
      flex: 1; background: #0d0d0d; border: 1px solid rgba(255,255,255,0.07);
      border-radius: 6px; padding: 5px 12px;
      font-size: 11px; color: #444; font-family: monospace;
    }
    .browser-url em { color: #666; font-style: normal; }
    .browser-screen { width: 100%; display: block; }

    /* MOBILE MOCKUP */
    .mobile-wrap {
      position: relative; width: 220px; flex-shrink: 0;
    }
    .mobile-frame {
      border-radius: 32px; overflow: hidden;
      border: 6px solid #1a1a1a;
      box-shadow: 0 32px 64px rgba(0,0,0,0.6), inset 0 0 0 1px rgba(255,255,255,0.05);
    }
    .mobile-notch {
      position: absolute; top: 6px; left: 50%; transform: translateX(-50%);
      width: 80px; height: 20px; background: #1a1a1a;
      border-radius: 0 0 14px 14px; z-index: 2;
    }

    /* SPLIT SHOWCASE */
    .split-showcase {
      display: flex; align-items: flex-start; gap: 40px;
      margin-bottom: 64px;
    }
    .split-showcase .browser-col { flex: 1; min-width: 0; }
    .split-showcase .mobile-col {
      flex-shrink: 0; display: flex; flex-direction: column;
      align-items: center; gap: 16px; padding-top: 20px;
    }

    /* SCROLLING SCREENSHOTS */
    .screens-row {
      display: grid; grid-template-columns: 1fr 1fr; gap: 20px;
      margin-bottom: 64px;
    }
    .screen-card {
      border-radius: 16px; overflow: hidden;
      border: 1px solid rgba(255,255,255,0.08);
      box-shadow: 0 16px 48px rgba(0,0,0,0.5);
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .screen-card:hover { transform: translateY(-4px); box-shadow: 0 24px 60px rgba(0,0,0,0.6); }
    .screen-card img { width: 100%; display: block; }
    .screen-label {
      background: #0f0f0f; padding: 12px 16px;
      font-size: 11px; font-weight: 700; color: var(--muted);
      text-transform: uppercase; letter-spacing: 1px;
      border-top: 1px solid rgba(255,255,255,0.05);
    }

    /* FAKE MOCKUP SITE SECTION */
    .mock-site {
      background: #0d0d0d; border: 1px solid rgba(255,255,255,0.08);
      border-radius: 24px; overflow: hidden; margin-bottom: 64px;
      box-shadow: 0 32px 80px rgba(0,0,0,0.6);
    }
    .mock-nav {
      background: #111; padding: 14px 24px;
      display: flex; align-items: center; justify-content: space-between;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .mock-nav-logo { font-size: 14px; font-weight: 900; color: #fff; letter-spacing: -0.5px; }
    .mock-nav-logo em { color: var(--accent); font-style: normal; }
    .mock-cta { background: var(--accent); color: #000; font-size: 11px; font-weight: 800; padding: 6px 14px; border-radius: 100px; text-decoration: none; letter-spacing: 0.5px; }

    .mock-hero {
      padding: 60px 40px 48px;
      background: linear-gradient(160deg, #0d0d0d 0%, #0a0a0a 100%);
      position: relative; overflow: hidden; text-align: center;
    }
    .mock-hero::before {
      content: ''; position: absolute; top: -40px; left: 50%; transform: translateX(-50%);
      width: 500px; height: 400px;
      background: radial-gradient(ellipse, rgba(200,255,0,0.05) 0%, transparent 70%);
      pointer-events: none;
    }
    .mock-badge {
      display: inline-flex; align-items: center; gap: 6px;
      background: rgba(200,255,0,0.08); border: 1px solid rgba(200,255,0,0.2);
      border-radius: 100px; padding: 4px 12px; margin-bottom: 20px;
      font-size:12px; font-weight: 700; color: var(--accent);
      text-transform: uppercase; letter-spacing: 1px;
    }
    .mock-badge span { width: 5px; height: 5px; border-radius: 50%; background: var(--accent); }
    .mock-h1 { font-size: clamp(28px,4vw,44px); font-weight: 900; letter-spacing: -2px; line-height: 1.05; margin-bottom: 14px; }
    .mock-h1 em { color: var(--accent); font-style: normal; }
    .mock-sub { font-size: 14px; color: var(--muted); line-height: 1.6; max-width: 420px; margin: 0 auto 32px; }
    .mock-stats {
      display: flex; align-items: center; justify-content: center; gap: 40px;
      padding-top: 32px; border-top: 1px solid rgba(255,255,255,0.06);
    }
    .mock-stat-num { font-size: 28px; font-weight: 900; letter-spacing: -1px; color: #fff; }
    .mock-stat-num em { color: var(--accent); font-style: normal; }
    .mock-stat-label { font-size: 11px; color: var(--muted); margin-top: 2px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }

    .mock-videos {
      padding: 32px 40px;
      border-top: 1px solid rgba(255,255,255,0.05);
      background: #0a0a0a;
    }
    .mock-videos-label { font-size:12px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; color: rgba(200,255,0,0.5); margin-bottom: 16px; }
    .mock-video-row { display: flex; gap: 12px; }
    .mock-video-thumb {
      flex: 1; aspect-ratio: 9/16; border-radius: 12px;
      background: linear-gradient(160deg,#1a1a1a,#111);
      border: 1px solid rgba(255,255,255,0.07);
      display: flex; align-items: center; justify-content: center;
      position: relative; overflow: hidden;
    }
    .mock-video-thumb::after {
      content: '▶'; font-size: 18px; color: rgba(255,255,255,0.2);
    }
    .mock-video-thumb:nth-child(1) { background: linear-gradient(160deg,#1a1500,#111); }
    .mock-video-thumb:nth-child(2) { background: linear-gradient(160deg,#001a12,#111); }
    .mock-video-thumb:nth-child(3) { background: linear-gradient(160deg,#0d0d1a,#111); }

    /* TIMELINE */
    .timeline {
      border-left: 1px solid rgba(255,255,255,0.08);
      padding-left: 32px; margin-bottom: 64px;
    }
    .timeline-step {
      position: relative; margin-bottom: 40px;
    }
    .timeline-step:last-child { margin-bottom: 0; }
    .timeline-dot {
      position: absolute; left: -40px; top: 4px;
      width: 16px; height: 16px; border-radius: 50%;
      background: var(--bg); border: 2px solid rgba(200,255,0,0.4);
      display: flex; align-items: center; justify-content: center;
    }
    .timeline-dot.done { background: var(--accent); border-color: var(--accent); }
    .timeline-dot.done::after { content: ''; width: 6px; height: 6px; border-radius: 50%; background: #000; }
    .timeline-time { font-size: 11px; font-weight: 700; color: var(--accent); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 6px; }
    .timeline-title { font-size: 16px; font-weight: 800; color: #fff; margin-bottom: 4px; }
    .timeline-desc { font-size: 13px; color: var(--muted); line-height: 1.6; }

    /* CTA BLOCK */
    .cta-block {
      background: linear-gradient(160deg, rgba(200,255,0,0.06) 0%, rgba(14,14,14,1) 70%);
      border: 1px solid rgba(200,255,0,0.15); border-radius: 24px;
      padding: 48px 32px; text-align: center; margin-bottom: 64px;
      position: relative; overflow: hidden;
    }
    .cta-block::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
      background: linear-gradient(90deg, transparent, rgba(200,255,0,0.5), transparent);
    }
    .cta-block h2 { font-size: clamp(28px,4vw,44px); font-weight: 900; letter-spacing: -2px; margin-bottom: 12px; }
    .cta-block p { font-size: 15px; color: var(--muted); margin-bottom: 32px; }
    .cta-btn {
      display: inline-flex; align-items: center; gap: 10px;
      background: var(--accent); color: #000;
      font-size: 14px; font-weight: 900; letter-spacing: 0.3px;
      padding: 16px 36px; border-radius: 100px; text-decoration: none;
      transition: transform 0.15s, box-shadow 0.15s;
      position: relative; overflow: hidden;
    }
    .cta-btn:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(200,255,0,0.3); }
    .cta-btn::after {
      content: ''; position: absolute; top: 0; left: -100%; width: 60%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
      transform: skewX(-20deg); animation: btnShine 3.5s ease-in-out infinite;
    }
    @keyframes btnShine { 0%{left:-100%} 40%,100%{left:160%} }

    /* SCROLL REVEAL */
    .reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.5s ease, transform 0.5s ease; }
    .reveal.visible { opacity: 1; transform: translateY(0); }

    @media (max-width: 768px) {
      .deliverables { grid-template-columns: 1fr 1fr; }
      .split-showcase { flex-direction: column; }
      .split-showcase .mobile-col { flex-direction: row; width: 100%; justify-content: center; }
      .screens-row { grid-template-columns: 1fr; }
      nav { padding: 12px 16px; }
      .mock-hero { padding: 40px 24px 32px; }
      .mock-videos { padding: 24px; }
      .mock-stats { gap: 24px; }
      .wrap { padding: 0 20px; }
    }
    @media (max-width: 480px) {
      .deliverables { grid-template-columns: 1fr; gap: 12px; margin-bottom: 40px; }
      .screens-row { gap: 12px; margin-bottom: 40px; }
      .del-card { padding: 16px; }
      .del-icon { font-size: 32px; margin-bottom: 8px; }
      .del-title { font-size: 14px; }
      .del-desc { font-size: 12px; }
      .price-pill { flex-direction: column; text-align: center; gap: 12px; }
      .wrap { padding: 0 16px; }
      .mock-hero { padding: 32px 16px 24px; }
      .mock-hero h1 { font-size: clamp(24px, 5vw, 40px); }
      .mock-hero .section-label { font-size: 11px; }
      .mock-videos { padding: 16px; gap: 12px; }
      .mock-stats { gap: 16px; padding: 16px; }
      .mock-stats > div { padding: 12px; }
      nav { padding: 10px 14px; }
    }
  </style>
</head>
<body>

<div class="top-banner">
  Like what you see?
  <a href="index.html">Get Your Site Built →</a>
</div>

<nav>
  <a class="nav-logo" href="index.html">Dream<em>.</em></a>
  <a class="nav-back" href="build.html">← Back to build</a>
</nav>

<section class="hero">
  <div class="wrap">
    <div class="badge"><span></span> Real deliverable · No templates</div>
    <h1>Here's exactly<br>what you get.</h1>
    <p>A custom creator site built around you. Your stats. Your videos. Your brand. Not a template — a real site that makes brands take you seriously.</p>

    <div class="price-pill">
      <div class="price-num" id="price-display">$300</div>
      <div class="price-meta">
        <strong>One-time. Flat. Done.</strong>
        <span id="price-subtitle">No monthly fees. No upsells. Yours forever.</span>
      </div>
    </div>
  </div>
</section>

<!-- DELIVERABLES GRID -->
<section style="padding-bottom:80px;">
  <div class="wrap">
    <div class="showcase-label reveal">Everything included</div>
    <div class="deliverables">
      <div class="del-card reveal">
        <div class="del-icon">🌐</div>
        <div class="del-title">Custom domain setup</div>
        <div class="del-desc">yourname.com connected and live. We handle DNS, SSL, and hosting config.</div>
      </div>
      <div class="del-card reveal">
        <div class="del-icon">📊</div>
        <div class="del-title">Live stats section</div>
        <div class="del-desc">Followers, views, engagement — pulled from your actual accounts and displayed on the site.</div>
      </div>
      <div class="del-card reveal">
        <div class="del-icon">🎬</div>
        <div class="del-title">Video showcase</div>
        <div class="del-desc">Your best content embedded and displayed in a scroll-stopping grid. Brands see your work instantly.</div>
      </div>
      <div class="del-card reveal">
        <div class="del-icon">💼</div>
        <div class="del-title">Brand rates page</div>
        <div class="del-desc">A clean, confident page showing what you offer and what it costs. No more DM negotiations from zero.</div>
      </div>
      <div class="del-card reveal">
        <div class="del-icon">📩</div>
        <div class="del-title">Contact form</div>
        <div class="del-desc">Brands submit a brief directly on your site. Goes straight to your inbox. You decide who you work with.</div>
      </div>
      <div class="del-card reveal">
        <div class="del-icon">📱</div>
        <div class="del-title">Mobile-first design</div>
        <div class="del-desc">Built for how brands actually look you up — on their phone, in 30 seconds, between meetings.</div>
      </div>
    </div>
  </div>
</section>

<!-- MOCK SITE PREVIEW -->
<section style="padding-bottom:80px;">
  <div class="wrap">
    <div class="showcase-label reveal">What it looks like</div>

    <!-- Browser mockup with fake creator site -->
    <div class="browser-wrap reveal" style="animation-delay:0.1s;">
      <div class="browser-bar">
        <div class="browser-dots">
          <span style="background:#ff5f57;"></span>
          <span style="background:#febc2e;"></span>
          <span style="background:#28c840;"></span>
        </div>
        <div class="browser-url"><em>https://</em>yourcreatorname.com</div>
        <div style="width:6px;height:6px;border-radius:50%;background:var(--accent);animation:pulse 2s infinite;flex-shrink:0;"></div>
      </div>

      <!-- Fake site inside the browser -->
      <div class="mock-site" style="border-radius:0;border:none;box-shadow:none;margin:0;">
        <div class="mock-nav">
          <div class="mock-nav-logo">Your Name<em>.</em></div>
          <a class="mock-cta" href="#">Work With Me</a>
        </div>

        <div class="mock-hero">
          <div class="mock-badge"><span></span> TikTok Shop Creator · Chicago</div>
          <div class="mock-h1">I make content<br>that <em>actually converts.</em></div>
          <div class="mock-sub">UGC creator specializing in TikTok Shop affiliate content. Health, beauty, and consumer products. Real results, real reviews.</div>
          <div class="mock-stats">
            <div>
              <div class="mock-stat-num">365<em>K+</em></div>
              <div class="mock-stat-label">Followers Built</div>
            </div>
            <div>
              <div class="mock-stat-num">$<em>4K</em></div>
              <div class="mock-stat-label">Brand Rev / Week</div>
            </div>
            <div>
              <div class="mock-stat-num">6<em>+</em></div>
              <div class="mock-stat-label">Active Partners</div>
            </div>
          </div>
        </div>

        <div class="mock-videos">
          <div class="mock-videos-label">Converting Content</div>
          <div class="mock-video-row">
            <div class="mock-video-thumb"></div>
            <div class="mock-video-thumb"></div>
            <div class="mock-video-thumb"></div>
            <div class="mock-video-thumb"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- REAL SCREENSHOTS -->
<section style="padding-bottom:80px;">
  <div class="wrap">
    <div class="showcase-label reveal">Real example — Kristyn's build</div>
    <div class="screens-row">
      <div class="screen-card reveal">
        <img src="./kristyn-site-1.png" alt="Kristyn creator site hero section">
        <div class="screen-label">Hero · Above the fold</div>
      </div>
      <div class="screen-card reveal">
        <img src="./kristyn-site-2.png" alt="Kristyn creator site content section">
        <div class="screen-label">Stats · Social proof</div>
      </div>
    </div>
  </div>
</section>

<!-- TIMELINE -->
<section style="padding-bottom:80px;">
  <div class="wrap">
    <div class="showcase-label reveal">How it happens</div>
    <div class="timeline">
      <div class="timeline-step reveal">
        <div class="timeline-dot done"></div>
        <div class="timeline-time">Day 0 — You submit</div>
        <div class="timeline-title">Fill out the brief</div>
        <div class="timeline-desc">Takes 5 minutes. Your TikTok handle, your stats, your best videos, your rates. That's it.</div>
      </div>
      <div class="timeline-step reveal">
        <div class="timeline-dot done"></div>
        <div class="timeline-time">Day 0–1 — Tyler reviews</div>
        <div class="timeline-title">Brief gets reviewed personally</div>
        <div class="timeline-desc">Not an AI. Not a VA. Tyler reads every brief and reaches out if anything's missing before starting.</div>
      </div>
      <div class="timeline-step reveal">
        <div class="timeline-dot done"></div>
        <div class="timeline-time">Day 1–2 — Build starts</div>
        <div class="timeline-title">First draft goes live</div>
        <div class="timeline-desc">You get a preview link to a real working site. Not a mockup. Not a PDF. A live URL you can click around.</div>
      </div>
      <div class="timeline-step reveal">
        <div class="timeline-dot"></div>
        <div class="timeline-time">Day 2 — Your feedback</div>
        <div class="timeline-title">You review and approve</div>
        <div class="timeline-desc">Change the copy. Swap a color. Move a section. We refine until it's exactly right. Unlimited revisions.</div>
      </div>
      <div class="timeline-step reveal">
        <div class="timeline-dot"></div>
        <div class="timeline-time">Day 2–3 — Done</div>
        <div class="timeline-title">Your site goes live on your domain</div>
        <div class="timeline-desc">Fully connected. Custom domain. SSL. You own it. Send the link in your next brand pitch.</div>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
